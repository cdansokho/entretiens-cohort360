# Exercice_Django — Variables d'environnement (copier en .env et adapter)
# cp .env.example .env

# Clé secrète Django (obligatoire en production)
DJANGO_SECRET_KEY=dev-secret-key-change-me

# Mode debug (0 ou 1 ; mettre 0 en production)
DJANGO_DEBUG=1

# Hôtes autorisés, séparés par des virgules (ex: localhost,127.0.0.1,app.example.com)
DJANGO_ALLOWED_HOSTS=*

# CORS : origines autorisées, séparées par des virgules (vide = tout autoriser, pratique en dev)
# Exemple prod : https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=

# Pagination : nombre max d'éléments par page pour les listes (défaut 100)
# MAX_PAGE_SIZE=100

# Base de données (optionnel : par défaut SQLite db.sqlite3)
# Pour PostgreSQL : DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=
